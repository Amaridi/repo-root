# =============================================================================
# Portail de Depot de Pieces — variables d'environnement de PRODUCTION
#
# A copier en `.env` SUR LE SERVEUR, puis a completer. Ce fichier-ci ne contient
# aucun secret ; install.sh en genere de nouveaux, aleatoires, au premier
# passage. Le `.env` n'est jamais commite ni transfere depuis la machine de
# developpement : les secrets de production naissent et restent sur le serveur.
#
# Difference essentielle avec .env.example (developpement) :
#   - les points d'entree sont 22400 (HTTP) et 22401 (HTTPS), relayes par le
#     proxy frontal de la plateforme ;
#   - les services se joignent par leur NOM DE SERVICE docker, pas par
#     localhost : aucun port n'est publie en dehors de nginx.
# =============================================================================

# --- Identite publique ------------------------------------------------------
# Le hostname servi. Il apparait dans le certificat, dans server_name, dans les
# liens de depot remis aux clients et dans les URLs signees du stockage.
SERVER_NAME=amar-idinarene.stage2-div.rayan-drissi.com
PUBLIC_BASE_URL=https://amar-idinarene.stage2-div.rayan-drissi.com

NODE_ENV=production

# --- Points d'entree (plage assignee 22400-22499, ecoute 127.0.0.1) ---------
# Imposes par la plateforme : port 80 externe -> 22400, port 443 -> 22401 en
# passthrough TLS. Ce sont les SEULS ports publies de toute la stack.
PORT_HTTP=22400
PORT_HTTPS=22401

# Port interne du backend, dans le reseau du compose. Il n'est PAS publie ;
# il figure ici parce que Prometheus s'en sert comme cible de scrape.
PORT_BACKEND=22409

# --- Base de donnees --------------------------------------------------------
POSTGRES_USER=depot
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=depot
# `postgres` est le nom du service docker : la base n'a aucun port publie.
DATABASE_URL=postgresql://depot:change_me_postgres@postgres:5432/depot?schema=public

# --- Authentification -------------------------------------------------------
# Deux secrets DISTINCTS : un token de depot ne doit jamais valoir un token
# avocat. install.sh en genere deux differents.
JWT_LAWYER_SECRET=change_me_lawyer_secret
JWT_LAWYER_TTL=8h
JWT_DEPOSIT_SECRET=change_me_deposit_secret
JWT_DEPOSIT_TTL=30m
# TLS est termine par nginx : les cookies sont Secure. Egalement force dans le
# compose de production, pour qu'une erreur ici ne puisse pas degrader la
# securite silencieusement.
COOKIE_SECURE=true

# --- Stockage objet ---------------------------------------------------------
S3_ACCESS_KEY=depot-minio
S3_SECRET_KEY=change_me_minio
# ATTENTION : ce nom est aussi le PREFIXE DE ROUTAGE nginx. Le changer impose de
# changer le bloc `location /depot-documents/` de la configuration nginx, sans
# quoi toutes les URLs signees deviennent injoignables.
S3_BUCKET=depot-documents
S3_REGION=us-east-1
# Endpoints poses directement dans docker-compose.prod.yml :
#   interne -> http://minio:9000        (HeadObject, Delete, serveur a serveur)
#   public  -> ${PUBLIC_BASE_URL}       (ce qui est SIGNE, donc joignable par le
#                                        navigateur via nginx)

# --- Regles metier ----------------------------------------------------------
DEPOSIT_LINK_TTL_DAYS=7
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_FILES_PER_REQUEST=10
PRESIGN_UPLOAD_TTL_SECONDS=600
PRESIGN_DOWNLOAD_TTL_SECONDS=60

# --- Compte avocat de demonstration ----------------------------------------
SEED_LAWYER_EMAIL=avocat@div-protocol.test
SEED_LAWYER_PASSWORD=change_me_seed
# Quotes OBLIGATOIRES : install.sh charge ce fichier avec `. ./.env`, et une
# valeur contenant des espaces y serait interpretee comme une commande.
SEED_LAWYER_NAME="Maitre Amar Idinarene"

# --- Observabilite ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
# Prometheus n'a pas d'authentification propre : nginx en pose une, basique,
# par-dessus TLS. install.sh genere le fichier htpasswd correspondant.
PROMETHEUS_BASIC_USER=metrics
PROMETHEUS_BASIC_PASSWORD=change_me_prometheus

# --- Certificat TLS ---------------------------------------------------------
# Adresse utilisee par Let's Encrypt pour les avertissements d'expiration.
CERTBOT_EMAIL=idiiiamaruss@gmail.com
# 1 = utiliser l'environnement de test de Let's Encrypt (quota tres large,
# certificat non reconnu par les navigateurs). install.sh fait de toute facon un
# dry-run avant toute emission reelle.
CERTBOT_STAGING=0

# --- Registre d'images ------------------------------------------------------
# Les images sont construites sur la machine de developpement et publiees ici.
# Le serveur ne fait que les tirer.
REGISTRY=ghcr.io
# Doit correspondre EXACTEMENT au compte GitHub proprietaire des paquets, en
# minuscules.
IMAGE_OWNER=amaridi
IMAGE_TAG=1.0.0
