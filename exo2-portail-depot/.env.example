# =============================================================================
# Portail de Depot de Pieces — variables d'environnement
# Copier en .env puis renseigner. Ne JAMAIS commiter .env.
# Les secrets se generent avec :  openssl rand -base64 32
# =============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development
# URL publique de l'application, telle que vue par le navigateur.
# Dev  : http://localhost:22480
# Prod : https://amar-idinarene.stage2-div.rayan-drissi.com
PUBLIC_BASE_URL=http://localhost:22480

# --- Ports (plage assignee : 22400-22499, ecoute sur 127.0.0.1 uniquement) ---
PORT_NGINX_HTTP=22480
PORT_NGINX_HTTPS=22443
PORT_BACKEND=22409
PORT_POSTGRES=22432
PORT_MINIO_API=22400
PORT_MINIO_CONSOLE=22401
PORT_GRAFANA=22490
PORT_PROMETHEUS=22491

# --- Base de donnees --------------------------------------------------------
POSTGRES_USER=depot
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=depot
# Depuis l'hote (migrations Prisma, dev) :
DATABASE_URL=postgresql://depot:change_me_postgres@localhost:22432/depot?schema=public
# Depuis un conteneur, utiliser l'hote reseau docker :
# DATABASE_URL=postgresql://depot:change_me_postgres@postgres:5432/depot?schema=public

# --- Authentification -------------------------------------------------------
# Deux secrets DISTINCTS : un token de depot ne doit jamais valoir un token avocat.
JWT_LAWYER_SECRET=change_me_lawyer_secret
JWT_LAWYER_TTL=8h
JWT_DEPOSIT_SECRET=change_me_deposit_secret
JWT_DEPOSIT_TTL=30m
COOKIE_SECURE=false

# --- Stockage objet (MinIO / S3) --------------------------------------------
S3_ACCESS_KEY=depot-minio
S3_SECRET_KEY=change_me_minio
S3_BUCKET=depot-documents
S3_REGION=us-east-1
# Endpoint interne : utilise par le backend (reseau docker ou localhost en dev).
S3_INTERNAL_ENDPOINT=http://localhost:22400
# Endpoint PUBLIC : celui qui est SIGNE dans les presigned URLs, donc celui que
# le navigateur doit pouvoir joindre. En prod, le bucket est le prefixe de
# routage nginx : https://<host>/depot-documents/<key>
S3_PUBLIC_ENDPOINT=http://localhost:22400

# --- Regles metier ----------------------------------------------------------
DEPOSIT_LINK_TTL_DAYS=7
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_FILES_PER_REQUEST=10
PRESIGN_UPLOAD_TTL_SECONDS=600
PRESIGN_DOWNLOAD_TTL_SECONDS=60

# --- Seed (compte avocat de demonstration) ----------------------------------
SEED_LAWYER_EMAIL=avocat@div-protocol.test
SEED_LAWYER_PASSWORD=change_me_seed
SEED_LAWYER_NAME=Maitre Amar Idinarene

# --- Observabilite ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# --- Registry (bloc 5) -----------------------------------------------------
REGISTRY=ghcr.io
IMAGE_OWNER=amar-idinarene
IMAGE_TAG=latest
