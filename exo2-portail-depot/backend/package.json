{
  "name": "depot-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Portail de Depot de Pieces — API NestJS",
  "scripts": {
    "build": "nest build",
    "start": "node ./node_modules/dotenv-cli/cli.js -e ../.env -- nest start",
    "start:dev": "node ./node_modules/dotenv-cli/cli.js -e ../.env -- nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node ./node_modules/dotenv-cli/cli.js -e ../.env -- prisma migrate dev",
    "prisma:deploy": "node ./node_modules/dotenv-cli/cli.js -e ../.env -- prisma migrate deploy",
    "prisma:seed": "node ./node_modules/dotenv-cli/cli.js -e ../.env -- prisma db seed",
    "prisma:studio": "node ./node_modules/dotenv-cli/cli.js -e ../.env -- prisma studio",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:reset": "node ./node_modules/dotenv-cli/cli.js -e ../.env -- prisma migrate reset"
  },
  "prisma": {
    "seed": "node ./node_modules/dotenv-cli/cli.js -e ../.env -- ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@prisma/client": "6.16.2",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "prisma": "6.16.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  }
}
